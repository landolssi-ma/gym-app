{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "acme",
	"main": "vinext/server/fetch-handler",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"directory": "dist/client",
		"binding": "ASSETS",
		"not_found_handling": "none",
		"html_handling": "none",
		"run_worker_first": [
			"/*",
			"!/_next/static/*",
			"!/*/_next/static/*",
			"!/@vite/*",
			"!/@id/*",
			"!/@fs/*",
			"!/@react-refresh",
			"!/node_modules/*",
			"!/app/*",
			"!/components/*",
			"!/config/*",
			"!/hooks/*",
			"!/lib/*"
		]
	},
	"observability": {
		"enabled": true
	},
	"workers_dev": false,
	"preview_urls": false,
	// Each product adds its own domain before the first deploy, for example:
	// "routes": [{ "pattern": "example.com", "custom_domain": true }],
	// Cloudflare creates the DNS record on deploy.
	//
	// Exactly one binding: Hyperdrive pools the Neon connection. Everything else comes from .env
	// locally and Worker secrets when deployed. The all-zero id is a placeholder; replace it with
	// the id from `wrangler hyperdrive create` before the first deploy. Local dev emulation keys off
	// the binding name via CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE, not this id.
	"hyperdrive": [
		{
			"binding": "HYPERDRIVE",
			"id": "00000000000000000000000000000000"
		}
	]
}
