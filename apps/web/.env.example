# Copy to .env for local dev (`pnpm bootstrap` does it); deploy the same keys to the Worker with
# `pnpm secrets:deploy`. Values below are dev dummies.
# Every key is required unless its section says "optional".

# ── App ───────────────────────────────────────────
APP_ORIGIN=http://localhost:5173
# At least 16 characters. Gates the health route used by `pnpm smoke`.
SMOKE_TOKEN=dev-smoke-token-change-me
# At least 16 characters. Hashes client IPs before they are stored for rate limiting.
RATE_LIMIT_SALT=dev-rate-limit-salt-change-me

# ── Database (Neon) ───────────────────────────────
# Local Docker Postgres from docker-compose.yml (host port 5433). Used by drizzle-kit and scripts;
# the Worker reaches the database through the HYPERDRIVE binding instead.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/postgres
# Local-dev override for the HYPERDRIVE binding: the name must stay exactly this --
# @cloudflare/vite-plugin picks it up because it starts with the CLOUDFLARE_ prefix Vite's
# loadEnv already watches. Same target as DATABASE_URL above.
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=postgres://postgres:postgres@127.0.0.1:5433/postgres

# ── Storage (R2 over the S3 API) ──────────────────
# R2 endpoint: https://<account-id>.r2.cloudflarestorage.com
S3_ENDPOINT=https://account-id.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=dev-s3-access-key-id
S3_SECRET_ACCESS_KEY=dev-s3-secret-access-key
S3_BUCKET=acme

# ── Auth ──────────────────────────────────────────
# At least 32 characters; `pnpm bootstrap` generates one.
BETTER_AUTH_SECRET=

# ── Email (Resend) ────────────────────────────────
MAIL_API_URL=https://api.resend.com
# Required when deployed. Leave empty in local dev: emails are logged instead of sent.
RESEND_API_KEY=

# ── Jobs (Inngest) ────────────────────────────────
# 1 only in local dev (the Inngest dev server skips request signing); 0 everywhere else.
INNGEST_DEV=1
INNGEST_EVENT_KEY=dev-inngest-event-key
INNGEST_SIGNING_KEY=dev-inngest-signing-key

# ── Billing (Dodo Payments) ────────────────────────
# Dodo dashboard API key. The dummy below lets the app start; real checkouts need a test key.
BILLING_API_KEY=dev-billing-api-key
# 1 for Dodo's test mode, 0 for live.
BILLING_TEST_MODE=1
# `pnpm billing:setup --mode test --url <origin>` writes these two. The dummies work with
# `pnpm billing:simulate`, which signs local webhooks with this secret.
BILLING_WEBHOOK_SECRET=whsec_ZGV2LWJpbGxpbmctd2ViaG9vay1zZWNyZXQ=
BILLING_PRODUCT_IDS={"starter:month":"pdt_dev_starter_month","starter:year":"pdt_dev_starter_year","pro:month":"pdt_dev_pro_month","pro:year":"pdt_dev_pro_year","business:month":"pdt_dev_business_month","business:year":"pdt_dev_business_year"}

# ── CMS (BaseHub) ─────────────────────────────────
# basehub.com -> your repo -> Connect panel. Blog, legal pages and changelog come from here;
# an empty repository renders every page with its empty state.
CMS_PROVIDER=basehub
CMS_API_URL=https://api.basehub.com/graphql
# Read token: runtime queries.
CMS_API_KEY=dev-cms-read-token
# Admin token: `pnpm --filter @workspace/cms cms:setup` only, never the running site.
CMS_ADMIN_API_KEY=dev-cms-admin-token

# ── Google sign-in (optional) ─────────────────────
# Leave either empty and Google sign-in turns off: no button, email code and password still work.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Analytics (PostHog, optional) ─────────────────
# Leave either empty and no analytics events are sent from the server or the browser.
POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# ── AI (Vercel AI Gateway, optional) ─────────────
# Leave either empty and AI is off: AI routes answer 503 ai_unavailable, everything else works.
# Key: vercel.com -> AI Gateway -> API keys. Model: any gateway id, provider/model.
AI_GATEWAY_API_KEY=
AI_MODEL=anthropic/claude-sonnet-5
